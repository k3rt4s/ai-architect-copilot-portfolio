# Required: Google Cloud project that hosts Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Vertex region (default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: Gemini model override (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# Required if Tesseract is not on PATH. Used for OCR of image inputs (PNG/JPG).
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
